<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
		<RootNamespace>Injectra.Benchmarks</RootNamespace>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="BenchmarkDotNet" Version="0.16.0-preview.2"/>
		<ProjectReference Include="../Core/Core.csproj" Condition="'$(ContainerAssembly)' == ''"/>
		<Reference Include="Injectra.Core" Condition="'$(ContainerAssembly)' != ''">
			<HintPath>$(ContainerAssembly)</HintPath>
		</Reference>
	</ItemGroup>
</Project>
