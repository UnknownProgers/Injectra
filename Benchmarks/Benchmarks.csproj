<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
		<RootNamespace>Injectra.Benchmarks</RootNamespace>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="BenchmarkDotNet" Version="0.16.0-preview.2"/>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0"/>
		<PackageReference Include="GroveGames.DependencyInjection" Version="0.8.1"/>
		<ProjectReference Include="../Core/Core.csproj" Condition="'$(ContainerAssembly)' == ''"/>
		<Reference Include="Injectra.Core" Condition="'$(ContainerAssembly)' != ''">
			<HintPath>$(ContainerAssembly)</HintPath>
		</Reference>
		<ProjectReference Include="../Generator/Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" Condition="'$(ContainerAssembly)' == ''"/>
	</ItemGroup>
</Project>
