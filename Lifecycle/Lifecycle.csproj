<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<AssemblyName>Injectra.Lifecycle</AssemblyName>
		<RootNamespace>Injectra.Lifecycle</RootNamespace>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageId>Injectra</PackageId>
		<Authors>UnknownProgers</Authors>
		<RepositoryUrl>https://github.com/UnknownProgers/Injectra</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://github.com/UnknownProgers/Injectra</PackageProjectUrl>
		<PackageTags>dependency-injection;gamedev;games;di</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeCoreInPackage</TargetsForTfmSpecificBuildOutput>
		<Description>A lightweight dependency injection library for .NET, designed primarily for game development.</Description>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="../Core/Core.csproj" PrivateAssets="all"/>
		<None Include="../README.md" Pack="true" PackagePath="/"/>
		<None Include="../LICENSE" Pack="true" PackagePath="/"/>
		<None Include="../icon.png" Pack="true" PackagePath="/"/>
		<None Include="../Generator/bin/$(Configuration)/netstandard2.0/Injectra.Generator.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
	</ItemGroup>
	<Target Name="IncludeCoreInPackage" DependsOnTargets="BuildOnlySettings;ResolveReferences">
		<ItemGroup>
			<BuildOutputInPackage Include="$(OutputPath)Injectra.Core.dll;$(OutputPath)Injectra.Core.xml"/>
		</ItemGroup>
	</Target>
</Project>
